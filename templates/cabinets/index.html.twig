{% extends 'base.html.twig' %}
{% import '_partials/media.html.twig' as ui %}

{% block title %}Armoires{% endblock %}

{% macro box(b) %}
    {% import '_partials/media.html.twig' as ui %}
    <div class="rounded-lg border bg-white p-3 {{ b.toReturn > 0 ? 'ring-2 ring-violet-300' : '' }}">
        <div class="mb-1 flex items-start justify-between gap-2">
            <div>
                <div class="font-bold">{{ b.location.name }}</div>
                <div class="text-xs text-slate-500">
                    {% if b.location.shelf %}Étagère {{ b.location.shelf }} · {% endif %}{{ b.count }} tape(s)
                    {% if b.copies is not empty %} · {{ b.copies|map(c => c.label)|join(', ') }}{% endif %}
                </div>
            </div>
            <div class="text-right text-xs">
                {% if b.toReturn > 0 %}<div class="font-semibold text-violet-700">{{ b.toReturn }} à rentrer</div>{% endif %}
                {% if b.nextExpiry %}<div class="text-slate-500">prochaine expiration<br><strong>{{ b.nextExpiry|date('d/m/Y') }}</strong></div>{% endif %}
            </div>
        </div>
        {% for c in b.cycles %}
            <div class="mt-2 rounded-md bg-slate-50 p-2">
                <div class="text-xs font-semibold text-slate-600">BackUp {{ c.cycle.backupDate ? c.cycle.backupDate|date('d/m/Y') : '?' }} · Retention {{ c.cycle.retentionDate ? c.cycle.retentionDate|date('d/m/Y', false) : '?' }}</div>
                <div class="mt-1 flex flex-wrap gap-1">
                    {% for m in c.media %}<span class="rounded bg-white px-1.5 py-0.5 text-xs ring-1 ring-slate-200 {{ m.toReturn ? 'ring-violet-400' : '' }}">{{ ui.barcode(m) }}</span>{% endfor %}
                </div>
            </div>
        {% endfor %}
        {% if b.noCycle is not empty %}
            <div class="mt-2 flex flex-wrap gap-1">
                {% for m in b.noCycle %}<span class="rounded px-1.5 py-0.5 text-xs ring-1 {{ m.toReturn ? 'bg-violet-50 ring-violet-400' : 'ring-slate-200' }}" title="{{ m.commvaultStatus }}">{{ ui.barcode(m) }}</span>{% endfor %}
            </div>
        {% endif %}
        {% if b.count == 0 %}<p class="mt-1 text-xs text-slate-400">Vide</p>{% endif %}
    </div>
{% endmacro %}

{% block body %}
    <h1 class="mb-4 text-2xl font-bold">Armoires et boîtes</h1>

    <div class="grid gap-6 lg:grid-cols-2">
        {% for row in cabinets %}
            <section class="rounded-xl bg-slate-200/60 p-4">
                <h2 class="mb-3 text-lg font-bold">{{ row.cabinet.label }}</h2>
                <div class="grid gap-3 sm:grid-cols-2">
                    {% for b in row.boxes %}{{ _self.box(b) }}{% else %}<p class="text-sm text-slate-500">Aucune boîte.</p>{% endfor %}
                </div>
            </section>
        {% endfor %}

        {% for b in offsite %}
            <section class="rounded-xl bg-amber-100/60 p-4">
                <h2 class="mb-3 text-lg font-bold">Site externe · {{ b.location.name }}</h2>
                {{ _self.box(b) }}
            </section>
        {% endfor %}
    </div>

    {% if cabinets is empty and offsite is empty %}
        <p class="rounded-lg bg-white p-6 text-slate-500 shadow-sm">Aucune armoire définie. Le référentiel armoires → boîtes se saisit dans l'admin (phase 6).</p>
    {% endif %}

    {% if unlocated is not empty %}
        <section class="mt-6 rounded-xl border border-amber-300 bg-white p-4 shadow-sm">
            <h2 class="mb-1 text-lg font-bold">Tapes hors TL sans emplacement connu</h2>
            <p class="mb-3 text-sm text-slate-500">Typiquement les tapes déjà sorties avant la mise en service de TapeTrack : à localiser.</p>
            {% for copy, tapes in unlocated %}
                <div class="mb-2">
                    <div class="text-sm font-semibold text-slate-600">{{ copy }} ({{ tapes|length }})</div>
                    <div class="mt-1 flex flex-wrap gap-1">
                        {% for m in tapes %}<span class="rounded px-1.5 py-0.5 text-xs ring-1 {{ m.toReturn ? 'bg-violet-50 ring-violet-400' : 'ring-slate-200' }}" title="{{ m.commvaultStatus }}{% if m.retainUntil %} · rétention {{ m.retainUntil|date('d/m/Y') }}{% endif %}">{{ ui.barcode(m) }}</span>{% endfor %}
                    </div>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {% if copiesWithoutBox is not empty %}
        <p class="mt-4 text-sm text-amber-800">Copies sans boîte attribuée : {{ copiesWithoutBox|map(c => c.label)|join(', ') }}.</p>
    {% endif %}
{% endblock %}
