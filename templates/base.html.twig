<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-100">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ app_name }}{% endblock %} · {{ app_name }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect x=%223%22 y=%227%22 width=%2226%22 height=%2218%22 rx=%223%22 fill=%22%230f172a%22/><circle cx=%2211%22 cy=%2216%22 r=%224%22 fill=%22%23f97316%22/><circle cx=%2221%22 cy=%2216%22 r=%224%22 fill=%22%23f97316%22/></svg>">
        {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/app.css') }}">{% endblock %}
        {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
    </head>
    <body class="min-h-full text-slate-900 antialiased">
        {% set run = last_sync() %}
        <header class="bg-slate-900 text-white">
            <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 text-lg font-bold tracking-tight">
                    <span class="inline-flex size-8 items-center justify-center rounded-lg bg-orange-500 text-sm">TT</span>
                    {{ app_name }}
                </a>
                <nav class="flex flex-wrap gap-1 text-sm font-medium">
                    {% for route, label in {app_dashboard: 'Maintenant', app_library: 'Tape library', app_cabinets: 'Armoires'} %}
                        <a href="{{ path(route) }}" class="rounded-md px-3 py-2 {{ app.current_route == route ? 'bg-slate-700 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' }}">{{ label }}</a>
                    {% endfor %}
                </nav>
                <div class="ml-auto flex items-center gap-3 text-sm">
                    <a href="{{ path('app_sync_history') }}" class="flex items-center gap-2 rounded-md px-2 py-1 hover:bg-slate-800" title="Historique des synchronisations">
                        {% if run is null %}
                            <span class="size-2.5 rounded-full bg-slate-400"></span><span class="text-slate-300">Jamais synchronisé</span>
                        {% elseif run.status.value == 'success' %}
                            <span class="size-2.5 rounded-full bg-emerald-400"></span>
                            <span class="text-slate-300">Synchro <span class="text-white">{{ run.finishedAt|ago }}</span></span>
                        {% else %}
                            <span class="size-2.5 animate-pulse rounded-full bg-red-500"></span>
                            <span class="font-semibold text-red-300">Synchro en échec {{ run.finishedAt|ago }}</span>
                        {% endif %}
                    </a>
                    <form method="post" action="{{ path('app_sync_now') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('sync-now') }}">
                        <button class="rounded-md bg-orange-500 px-3 py-2 font-semibold text-white shadow hover:bg-orange-400">Synchroniser maintenant</button>
                    </form>
                </div>
            </div>
        </header>

        <main class="mx-auto max-w-7xl px-4 py-6">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg border px-4 py-3 text-sm {{ type == 'error' ? 'border-red-300 bg-red-50 text-red-800' : 'border-emerald-300 bg-emerald-50 text-emerald-800' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
