# Copy to docker/tapetrack.env (not committed). NO credentials here:
# the password goes in docker/secrets/commvault_password.
COMMVAULT_CLIENT=http
COMMVAULT_BASE_URL=https://commserve.example.local/commandcenter/api
COMMVAULT_AUTH_MODE=login
COMMVAULT_USERNAME=api_sa
# PEM of the internal CA (AD CS), as mounted from docker/certs/. Empty = system trust store.
COMMVAULT_CA_BUNDLE=/certs/ca.pem
COMMVAULT_LOG_LEVEL=info
